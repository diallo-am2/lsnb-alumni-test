{
  "name": "lsnb-alumni",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "setup:api": "npm --prefix api ci --include=dev",
    "dev:api": "npm --prefix api run dev",
    "build": "tsc -b && vite build",
    "build:api": "npm --prefix api run build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "typecheck:api": "npm --prefix api run typecheck",
    "test:api": "npm --prefix api run test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
