# ~/.config/lsnb-sync/sync.env  (the replica, i.e. the A1) — copy this file, then run: lsnb-sync doctor

# The live Supabase machine (VM1). A private VCN address is better than a public one.
PRIMARY_HOST="10.0.0.12"
PRIMARY_USER="ubuntu"
SSH_KEY="$HOME/.ssh/lsnb_replica"     # no spaces in this path
SSH_PORT=22

# How to reach the replica's own database. The user must own the tables (supabase_admin is safest).
LOCAL_PSQL="docker exec -i supabase-db psql -U supabase_admin -d postgres"

# Where this machine's storage service keeps its files (must match its docker-compose volume).
STORAGE_DEST="$HOME/supabase/docker/volumes/storage"

# Everything below is optional (defaults shown).
# WORK_DIR="$HOME/lsnb-sync"
# SYNC_SCHEMAS="auth public storage"
# EXCLUDE_TABLES="auth.schema_migrations storage.migrations"
# GUARD_TABLES="auth.users public.profiles"
# MAX_AGE_MIN=180                       # `lsnb-sync status` complains beyond this
# HEALTHCHECK_URL="https://hc-ping.com/your-uuid"   # optional dead-man's switch (healthchecks.io)
