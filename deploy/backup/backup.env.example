# ~/.config/lsnb-backup/backup.env — copy this file, then run: lsnb-backup doctor

# PUBLIC age key(s) only (age1…). The private key stays offline with the team, never on a server.
AGE_RECIPIENT="age1...................................................................."

# rclone "remote:bucket" (see README), and a folder name that stays the same whichever machine
# is the live one, so that history continues after a failover.
REMOTE="r2:lsnb-backups"
# Without any cloud account: a local folder (an absolute path), copied to a personal PC by hand
# or by a scheduled rsync (see README, "Variante sans cloud"):
# REMOTE="/home/ubuntu/lsnb-backups"
PREFIX="lsnb"

# On VM1 docker and some files need sudo (the user has passwordless sudo):
DB_PGDUMP="sudo -n docker exec -i supabase-db pg_dump -U postgres -d postgres"
PRIV_CMD="sudo -n"

STORAGE_DIR="$HOME/supabase/docker/volumes/storage"
CONFIG_DIR="$HOME/supabase/docker"          # .env, docker-compose.yml, volumes/{api,db/*.sql,templates}
EXTRA_PATHS="/etc/nginx/sites-available"    # optional: other files worth keeping (space separated)

# Everything below is optional (defaults shown).
# KEEP_DAYS=30              # daily history; older ones are removed, except the 1st-of-month ones
# KEEP_MONTHLY_DAYS=400     # monthly history
# MAX_AGE_HOURS=30          # `verify` complains when the latest database backup is older
# FULL_EVERY_DAYS=7         # files/config are re-sent at least this often even if unchanged
# HEALTHCHECK_URL="https://hc-ping.com/uuid-of-the-backup-check"
# VERIFY_HEALTHCHECK_URL="https://hc-ping.com/uuid-of-the-verify-check"
