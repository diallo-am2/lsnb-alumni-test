PORT=4000
FRONTEND_ORIGINS=http://localhost:5173
LOG_LEVEL=info
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-secret-key
# Weekly job only: never use VITE_ for these values.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5-nano

# E-mail notifications for the "Demandes" inbox (all optional: without them the
# notification route answers 503 and requests simply stay visible on the site).
# Same Brevo SMTP account as the Supabase auth e-mails.
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SITE_URL=https://your-site.example.org
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
MAIL_FROM=LSNB Réseau <no-reply@your-site.example.org>
